# PostgreSQL (Railway l'expose automatiquement)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/rush

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379

# NextAuth (à venir)
AUTH_SECRET=changeme-generate-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Seed admin (utilisé par `pnpm --filter @rush/db seed`)
SEED_ADMIN_EMAIL=admin@rush.local
SEED_ADMIN_PASSWORD=rush-admin
SEED_ADMIN_NAME=Admin

# Storage
BANK_DIR=./data/bank

# Publer
PUBLER_API_KEY=
PUBLER_WORKSPACE_ID=

# Pinterest
PINTEREST_COOKIES=

# News scraper (optional, fallback to RSS-only if absent)
TAVILY_API_KEY=

# Claude (Anthropic) — carousel generation
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5-20250929
